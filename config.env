# Settings for the PR review agent. Sourced by the scripts and read by the agent.
# Logins may contain letters, digits and hyphens only. Lists are space-separated.

# Repository to watch, as owner/name.
REPO="InfusemediaTeam/inkhub-skeleton"

# The branch PRs are opened against.
BASE_BRANCH="master"



# Local clone of REPO. PR checkouts go into .claude/worktrees/pr-<number> under it.
LOCAL_CHECKOUT="C:/Users/DenisErmakov/www/inkhub-skeleton"

# The account reviews are requested from and posted as. Must be the active `gh` account.
REVIEW_AS="errmakov-fuse"

# Every login that is "me". A PR from any of these is mine; a review from any of
# these counts as my review. Keep old logins here for as long as their PRs are open.
MY_LOGINS="errmakov-fuse errmakov"

# Authors whose new PRs get a code review.
WATCHED_AUTHORS="romanvasilenko-infuse samrent-infuse roman-vasi1enko samrent"

# Who is requested as reviewer on my own PRs when they have none.
MY_PR_REVIEWER="samrent-infuse"

# A PR whose title contains any of these is ignored completely: no review, no
# re-review, no reviewer request. Matched as plain text, ignoring case. One
# quoted keyword per entry; a keyword may contain spaces but not " or \.
SKIP_TITLE_KEYWORDS=("S.Y.S.T.E.M")

# Seconds between polls of the open PR list (the interval of the scheduled task,
# rounded to whole minutes). A poll that finds nothing costs no tokens.
POLL_SECONDS=300

# Git Bash, which the Windows scheduled task runs the scripts with.
GIT_BASH="C:/Users/DenisErmakov/AppData/Local/Programs/Git/bin/bash.exe"

# Each review is a fresh headless Claude run. The orchestrator checks the PR out,
# briefs one reviewer subagent, checks the findings the verdict rests on, and posts.
# Models are Claude Code aliases (opus, sonnet, haiku, fable) or full model ids.
ORCHESTRATOR_MODEL="opus"
REVIEWER_MODEL="opus"

# At most this many reviews run at the same time.
MAX_PARALLEL_REVIEWS=3

# A review run is stopped after this many minutes, or once it has spent this many
# US dollars (the CLI's own estimate). It is then tried again on a later poll, up
# to MAX_ATTEMPTS runs per PR head, after which you get a notification instead.
RUN_TIMEOUT_MINUTES=90
MAX_RUN_USD=25
MAX_ATTEMPTS=2

# A PR whose changes I requested is re-reviewed after new commits, once its head
# has stayed the same for this many seconds and its CI checks have finished
# without a failure. An explicit re-request skips both waits.
# Authors often push several fixes in a row; each extra re-review costs a full
# reviewer run, so this is set well above the time between two fix-up pushes.
REREVIEW_SETTLE_SECONDS=1800

# true = also re-review when my approval was dismissed by new commits (the repository
# dismisses stale approvals, so the PR cannot merge until it is approved again).
# false = only after a change request or an explicit re-request.
REREVIEW_DISMISSED_APPROVALS=true

# Draft PRs from WATCHED_AUTHORS.
# false = a draft is reviewed only when my review is requested on it.
# true = every draft is reviewed like a ready PR, requested or not.
# My own drafts never get a reviewer requested, whatever this is set to.
REVIEW_DRAFTS=false

